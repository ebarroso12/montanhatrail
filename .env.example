# Copie para .env.local (nunca commitar) ou configure em Vercel → Settings → Environment Variables.
# Todas estas variáveis são lidas apenas no servidor (funções em /api); nenhuma vai para o navegador.

# Postgres do Supabase — pooler Supavisor em modo transação
PGHOST=
PGPORT=6543
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
# PGSSLMODE=disable  # somente para um Postgres local de desenvolvimento, sem SSL

# Supabase Storage — upload de imagens pelo painel
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products

# URL pública canônica do site (SEO, sitemap, Open Graph). Opcional.
SITE_URL=

# --- Meta (Facebook/Instagram) Ads ---
# ID numérico do pixel (Gerenciador de Eventos). Sem esta variável o pixel
# simplesmente não é injetado e o site roda exatamente como antes.
META_PIXEL_ID=
# Token de verificação de domínio (Gerenciador de Negócios → Segurança da
# marca → Domínios). Necessário para configurar eventos agregados.
META_DOMAIN_VERIFICATION=
